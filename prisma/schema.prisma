generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserOrder {
  id          String   @id @default(uuid())
  inputToken  String
  outputToken String
  amount      Float
  status      String   @default("pending") // pending, routing, building, submitted, confirmed, failed
  result      Json?    // Stores txHash, price, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        ExecutionLog[]
}

model ExecutionLog {
  id        String   @id @default(uuid())
  orderId   String
  order     UserOrder @relation(fields: [orderId], references: [id])
  status    String
  message   String
  timestamp DateTime @default(now())
}
